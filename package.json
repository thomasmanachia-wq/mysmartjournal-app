{
  "name": "mysmartjournal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "remotion:studio": "remotion studio src/remotion/index.js",
    "remotion:render": "remotion render src/remotion/index.js TradeAuditShort out/trade-audit-short.mp4",
    "remotion:still": "remotion still src/remotion/index.js TradeAuditShort out/preview-frame.png --frame=120",
    "remotion:bulk": "node src/remotion/bulk-render.js",
    "remotion:bulk:stills": "node src/remotion/bulk-render.js --still",
    "remotion:autopsy": "remotion render src/remotion/index.js SplitAutopsy out/split-autopsy-v1.mp4",
    "remotion:autopsy:still": "remotion still src/remotion/index.js SplitAutopsy out/split-autopsy-preview.png --frame=60",
    "remotion:coldmath": "remotion render src/remotion/index.js ColdMathSimulator out/cold-math-simulator.mp4",
    "remotion:coldmath:still": "remotion still src/remotion/index.js ColdMathSimulator out/cold-math-preview.png --frame=285"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "framer-motion": "^13.4.2",
    "helmet": "^8.1.0",
    "lucide-react": "^1.8.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "posthog-js": "^1.373.4",
    "posthog-node": "^5.34.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.10.1",
    "resend": "^6.12.4",
